{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://justrunme.com/schemas/gpu-admission-evidence-envelope-1.0.0.json",
  "title": "GPU Admission Evidence Envelope",
  "description": "Compatible with agent-security-contract evidence-envelope.schema.json (schema_version 1.0.0). details.decision and details.inputs_digest carry GPU-admission fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "policy_sha256",
    "scenario_id",
    "verdict",
    "reason",
    "trace_id",
    "commit_sha",
    "timestamp",
    "envelope_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "string",
      "enum": ["ALLOW", "BLOCK", "REQUIRE_APPROVAL"]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "commit_sha": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "blocked_call_id": {
      "type": ["string", "null"]
    },
    "details": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["ALLOW", "DENY", "HOLD"]
        },
        "inputs_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "acs_disposition": {
      "type": "string",
      "enum": ["ALLOW", "DENY", "ASK"],
      "description": "OWASP ACS-aligned disposition mapping"
    },
    "envelope_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 of canonical JSON of all other fields. Integrity check, not a signature."
    }
  }
}
